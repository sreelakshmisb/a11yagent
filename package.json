{
  "name": "a11yagent",
  "displayName": "a11yagent",
  "description": "",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.102.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onChatParticipant:accessibility-agent.participant"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "chatParticipants": [
      {
        "id": "accessibility-agent.participant",
        "name": "a11yagent",
        "fullName": "Accessibility Agent",
        "description": "Ask me accessibility-related questions",
        "commands": [
          {
            "name": "help",
            "description": "Help me with accessibility features in VS Code"
          }
        ],
        "isSticky": true,
        "disambiguation": [
          {
            "category": "accessibility",
            "description": "Questions about accessibility in VS Code (help dialog, Accessible View, signals).",
            "examples": [
              "Open accessibility help",
              "How do I turn on screen reader mode?",
              "What is Accessible View?"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.102.0",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.25.1",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@types/jsdom": "^21.1.7",
    "fuse.js": "^7.1.0",
    "jsdom": "^27.0.0"
  }
}
