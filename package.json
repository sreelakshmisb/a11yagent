{
  "name": "a11yagent",
  "displayName": "a11yagent",
  "description": "",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.102.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onChatParticipant:accessibility-agent.participant"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "chatParticipants": [
      {
        "id": "accessibility-agent.participant",
        "name": "a11yagent",
        "fullName": "Accessibility Agent",
        "description": "Ask me accessibility-related questions",
        "commands": [
          {
            "name": "init",
            "description": "initialize a11yagent"
          }
        ],
        "isSticky": true,
        "disambiguation": [
          {
            "category": "accessibility",
            "description": "Questions about accessibility features in VS Code",
            "examples": [
              "What's the shortcut for opening the Accessibility View?",
              "How do I turn on screen reader mode?",
              "How do I reduce the volume of my accessibility signals?"
            ]
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "a11yagent.logFeature",
        "title": "a11yagent: Log an Issue or Feature"
      },
      {
        "command": "a11yagent.removeTrackedFeature",
        "title": "a11yagent: View/Remove a Tracked Issue or Feature"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.5.2",
    "@types/tail": "^2.2.3",
    "@types/vscode": "^1.102.0",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.25.1",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@types/jsdom": "^21.1.7",
    "@vscode/extension-telemetry": "^1.0.0",
    "axios": "^1.12.2",
    "fuse.js": "^7.1.0",
    "jsdom": "^27.0.0",
    "node-fetch": "^3.3.2",
    "tail": "^2.2.6",
    "vscode-extension-telemetry": "^0.4.5"
  },
  "type": "module"
}
