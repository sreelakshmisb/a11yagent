{
  "name": "a11yagent",
  "publisher": "IDEA",
  "displayName": "a11yagent",
  "description": "A VS Code extension that helps screenreader users discover accessibility features and troubleshoot accessibility-related issues in VS Code",
  "version": "0.0.1",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/idea11y/a11yagent"
  },
  "engines": {
    "vscode": "^1.102.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onChatParticipant:accessibility-agent.participant"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "chatParticipants": [
      {
        "id": "accessibility-agent.participant",
        "name": "a11yagent",
        "fullName": "Accessibility Agent",
        "description": "Ask me accessibility-related questions",
        "commands": [
          {
            "name": "init",
            "description": "initialize a11yagent"
          },
          {
            "name": "issue",
            "description": "describe the issue you are facing and the agent will match it against known issues"
          },
          {
            "name": "log",
            "description": "log issue number - fetch a specific GitHub issue by number and add it to tracked issues"
          },
          {
            "name": "view",
            "description": "view/remove tracked issues"
          },
          {
            "name": "update",
            "description": "update tracked issues"
          }
        ],
        "isSticky": true,
        "disambiguation": [
          {
            "category": "accessibility",
            "description": "Questions about accessibility features in VS Code",
            "examples": [
              "What's the shortcut for opening the Accessibility View?",
              "How do I turn on screen reader mode?",
              "How do I reduce the volume of my accessibility signals?"
            ]
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "a11yagent.removeTrackedFeature",
        "title": "a11yagent: View/Remove Tracked Features"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.5.2",
    "@types/tail": "^2.2.3",
    "@types/vscode": "^1.102.0",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.25.1",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@modelcontextprotocol/sdk": "^1.21.1",
    "@types/jsdom": "^21.1.7",
    "@vscode/chat-extension-utils": "^0.0.0-alpha.5",
    "@vscode/extension-telemetry": "^1.0.0",
    "@vscode/prompt-tsx": "0.3.0-alpha.24",
    "axios": "^1.12.2",
    "fuse.js": "^7.1.0",
    "jsdom": "^27.0.0",
    "node-fetch": "^3.3.2",
    "tail": "^2.2.6",
    "vscode-extension-telemetry": "^0.4.5"
  },
  "type": "module",
  "overrides": {
    "@vscode/prompt-tsx": "0.3.0-alpha.24"
  }
}
