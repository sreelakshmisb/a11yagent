{
  "compilerOptions": {
    "module": "Nodenext",
    "target": "ESNext",
    "outDir": "out",
    "lib": ["ESNext"],
    "sourceMap": true,
    "rootDir": "src",
    "strict": true,
    "types": ["node", "vscode", "mocha"],
    "typeRoots": ["./src/types", "./node_modules/@types"],
    "jsx": "react",
    "jsxFactory": "vscpp",
    "jsxFragmentFactory": "vscppf"
  }
}
